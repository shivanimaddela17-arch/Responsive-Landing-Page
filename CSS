:root {
  --bg: #0f172a;
  --surface: #111827;
  --surface-light: #1f2937;
  --text: #e2e8f0;
  --muted: #94a3b8;
  --accent: #60a5fa;
  --accent-strong: #3b82f6;
  --radius: 22px;
  --shadow: 0 24px 80px rgba(15, 23, 42, 0.25);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: radial-gradient(circle at top, rgba(96, 165, 250, 0.14), transparent 28%),
    linear-gradient(180deg, #020617 0%, #090b15 100%);
  color: var(--text);
  min-height: 100vh;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  width: 100%;
  backdrop-filter: blur(14px);
  background: rgba(15, 23, 42, 0.5);
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
}

.navbar {
  max-width: 1180px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background 0.4s ease, padding 0.3s ease, box-shadow 0.3s ease;
}

.navbar.scrolled {
  padding: 0.8rem 1.5rem;
  background: rgba(15, 23, 42, 0.92);
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.16);
}

.brand {
  font-family: 'Poppins', sans-serif;
  font-size: 1.2rem;
  letter-spacing: 0.06em;
  color: var(--accent);
}

.nav-menu {
  list-style: none;
  display: flex;
  gap: 1.8rem;
  margin: 0;
  padding: 0;
}

.nav-menu li a {
  color: var(--text);
  font-weight: 500;
  transition: color 0.25s ease, transform 0.25s ease;
}

.nav-menu li a:hover,
.nav-menu li a:focus {
  color: var(--accent);
  transform: translateY(-1px);
}

.section {
  padding: 6rem 1.5rem;
}

.hero {
  min-height: calc(100vh - 80px);
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 3rem;
  max-width: 1180px;
  margin: 0 auto;
}

.hero-content {
  max-width: 560px;
}

.eyebrow {
  display: inline-flex;
  margin-bottom: 1rem;
  color: var(--accent);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-size: 0.86rem;
}

.hero h1 {
  margin: 0;
  font-size: clamp(2.6rem, 5vw, 4.25rem);
  line-height: 1.02;
}

.hero p {
  margin: 1.8rem 0 2.2rem;
  line-height: 1.85;
  max-width: 45rem;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 3.6rem;
  padding: 0 1.5rem;
  border-radius: 999px;
  border: 1px solid transparent;
  transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
}

.btn:hover,
.btn:focus {
  transform: translateY(-2px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  color: #fff;
}

.btn-secondary {
  background: transparent;
  color: var(--text);
  border-color: rgba(148, 163, 184, 0.32);
}

.hero-visual {
  display: grid;
  gap: 1rem;
  justify-content: center;
}

.visual-card {
  min-height: 6.8rem;
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.05);
  box-shadow: var(--shadow);
  display: grid;
  place-items: center;
  font-size: 1.1rem;
  color: var(--text);
  border: 1px solid rgba(148, 163, 184, 0.08);
}

.card-1 {
  transform: translateX(10%);
}

.card-2 {
  transform: translateX(-10%);
}

.card-3 {
  transform: translateX(4%);
}

.info-section {
  background: rgba(15, 23, 42, 0.85);
}

.section-grid {
  max-width: 1180px;
  margin: 0 auto;
  display: grid;
  gap: 2.5rem;
}

.section-label {
  color: var(--accent);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.8rem;
}

.feature-list {
  display: grid;
  gap: 1.5rem;
}

.feature-item {
  padding: 1.7rem;
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(148, 163, 184, 0.08);
}

.feature-item h3 {
  margin-top: 0;
}

.services-section {
  max-width: 1180px;
  margin: 0 auto;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 1.5rem;
  margin-top: 2rem;
}

.service-card {
  padding: 2rem;
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(148, 163, 184, 0.08);
  transition: transform 0.25s ease, background 0.25s ease;
}

.service-card:hover {
  transform: translateY(-6px);
  background: rgba(96, 165, 250, 0.1);
}

.contact-grid {
  grid-template-columns: 1.2fr 1fr;
  gap: 2rem;
  max-width: 1180px;
  margin: 0 auto;
}

.contact-form {
  display: grid;
  gap: 1rem;
  padding: 2rem;
  border-radius: var(--radius);
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.12);
}

.contact-form label {
  display: grid;
  gap: 0.65rem;
  font-size: 0.95rem;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.04);
  color: var(--text);
  padding: 0.95rem 1rem;
}

.contact-form input:focus,
.contact-form textarea:focus {
  outline: none;
  border-color: rgba(96, 165, 250, 0.75);
  box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.14);
}

.footer {
  padding: 2rem 1.5rem;
  text-align: center;
  color: var(--muted);
}

@media (max-width: 860px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .hero-visual {
    grid-template-columns: repeat(3, 1fr);
  }

  .services-grid,
  .contact-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .navbar {
    padding: 0.75rem 1rem;
  }

  .nav-menu {
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .hero {
    padding-top: 3rem;
  }

  .hero-visual {
    grid-template-columns: 1fr;
  }

  .visual-card {
    min-height: 5.5rem;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 8vw, 3rem);
  }

  .section {
    padding: 4.5rem 1rem;
  }

  .btn {
    width: 100%;
  }
}
